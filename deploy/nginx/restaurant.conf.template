# This file is included from nginx's http {} context (for example via
# /etc/nginx/conf.d/*.conf). Replace every documented template token before enabling it.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream restaurant_backend {
    server __BACKEND_HOST__:__BACKEND_PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:restaurant_tls:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # WEB_ROOT contains the customer dist contents directly and the admin dist
    # contents in WEB_ROOT/admin/. See deploy/README.md for the staging layout.
    root __WEB_ROOT__;
    index index.html;

    # A trailing slash on proxy_pass deliberately strips the /api/ prefix.
    # Example: /api/orders/1 -> /orders/1 on the Spring Boot server.
    location /api/ {
        proxy_pass http://restaurant_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # No URI suffix on proxy_pass: /ws/kitchen is preserved for the backend.
    # Because this endpoint is exposed by the TLS server, the browser's
    # same-origin production URL is wss://__DOMAIN__/ws/kitchen.
    location /ws/ {
        proxy_pass http://restaurant_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    location = /admin {
        return 308 /admin/;
    }

    # Admin SPA and its /admin/assets/* files live under WEB_ROOT/admin/.
    location ^~ /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }

    # Customer SPA owns every other non-API route.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
